    { "key": "scope-readiness", "name": "Scope and readiness", "accountableRoleKey": "shi-engagement-lead", "dependsOn": ["qualification-discovery"], "checklistItemKeys": ["scope-version", "exclusions", "estimates", "assigned-team", "prerequisites", "acceptance-criteria"] },
