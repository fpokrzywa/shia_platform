# Required. Use a dedicated PostgreSQL database for this application.
DATABASE_URL=postgresql://user:password@localhost:5432/shi_agentic_platform

# Optional local server settings.
PORT=0
HOST=127.0.0.1
STORAGE_DIR=./data
SESSION_SECRET=replace-with-a-random-local-secret
# Set this to the browser-facing origin when TLS terminates at a reverse proxy.
# PUBLIC_ORIGIN=https://your-domain.example

# Optional private reviewer-guide import file; never commit its content.
# SHI_PRACTICE_REFERENCE_FILE=./private/practice-reference-content.json
